.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 品牌标识 */
.brand {
  text-align: center;
  margin-bottom: 30rpx;
}

.brand-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #c0392b;
  margin-bottom: 8rpx;
}

.brand-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #c0392b;
}

/* 区域 */
.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

/* 输入字段 */
.field {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 280rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
}

/* 按钮 */
.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  text-align: center;
}

.btn-primary {
  background-color: #c0392b;
  color: #fff;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 结果区域 */
.result-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-row:last-child {
  border-bottom: none;
}

.result-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.result-value {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.color-blue {
  color: #1a5276;
}

.color-green {
  color: #27ae60;
}

.color-red {
  color: #c0392b;
}

.color-default {
  color: #333;
}

/* 错误信息 */
.error-msg {
  text-align: center;
  padding: 20rpx;
  color: #c0392b;
  font-size: 26rpx;
}
